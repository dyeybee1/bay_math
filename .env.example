# Copy this file to ".env" (same folder as pubspec.yaml) and fill in the
# values from your Supabase project's Settings > API page.
#
# ".env" is git-ignored on purpose. Never commit real keys.
# The anon/public key is safe for client apps by design (Row Level Security
# governs access), but it should still not be hardcoded in source control
# to make key rotation and per-environment config easy.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Public HTTPS URL of the deployed Flutter Web recovery route. Replace the
# placeholder host; do not use a baymath:// URI for the portable Windows app.
STAFF_PASSWORD_RESET_REDIRECT_URL=https://YOUR-HOST/reset-password
